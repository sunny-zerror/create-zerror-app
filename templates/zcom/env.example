# Copy to .env.local and fill in. Leave the z-commerce values empty to run on
# the built-in demo catalogue (src/data/mock-products.ts).

# Public URL of this storefront — used for canonical URLs, sitemap and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# z-commerce GraphQL endpoint, e.g. https://api.your-zcommerce-host.com/graphql
NEXT_PUBLIC_GRAPHQL_API_URL=

# z-commerce REST base (payment verification after Nimbbl), e.g. https://api.your-zcommerce-host.com
NEXT_PUBLIC_BACKEND_ENDPOINT=

# The client's store token from the z-commerce admin. Sent as the `dbtoken`
# header on every request; it picks which client database the API reads.
NEXT_PUBLIC_DB_TOKEN=
