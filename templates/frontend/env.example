# Copy to .env.local and fill in. On Vercel, add the same keys under Settings → Environment Variables.

# Production URL — canonical links, sitemap, robots.txt, social cards, JSON-LD and llms.txt use it.
# On Vercel it falls back to the project's production domain when left empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search Console / Bing Webmaster Tools verification — only the content="…" value of their meta tag
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Contact form (src/app/api/contact). Server-only: never prefix these with NEXT_PUBLIC_.
# Gmail / Google Workspace: SMTP_PASS is an App Password (Google Account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives enquiries — defaults to siteConfig.contact.email
CONTACT_TO=
